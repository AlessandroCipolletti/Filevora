# Filevora reads process environment variables that you export.
# It does not load this file automatically. Copy values into the host app's env.
# Placeholders only. Do not put real credentials here.

FILES_ENV=development
FILES_PROVIDER=embedded
FILES_RUNTIME=long-running
FILES_STORAGE_DRIVER=filesystem
FILES_STORAGE_ROOT=./.files/objects
FILES_METADATA_DRIVER=sqlite
FILES_SQLITE_PATH=./.files/metadata.sqlite
FILES_POSTGRES_SCHEMA=filevora
FILES_PROCESSING_MODE=worker
FILES_WORKER_AUTOSPAWN=true
FILES_KEEP_ORIGINAL=true
FILES_DEFAULT_VISIBILITY=private
FILES_DEFAULT_PRESET=web-optimized
FILES_ALLOW_PUBLIC_FILES=false
FILES_RETENTION_ENABLED=false

# Part size for filesystem and S3 uploads. Default 8388608. Minimum 65536.
# FILES_UPLOAD_CHUNK_BYTES=65536
# Upload session lifetime in seconds. Default 86400. Range 60 to 604800.
# FILES_UPLOAD_SESSION_TTL_SECONDS=86400

# Reserved for a future managed provider. Ignored unless provider=managed,
# which currently fails with FEATURE_NOT_AVAILABLE.
# FILES_CLOUD_API_KEY=
# FILES_CLOUD_ENDPOINT=
# FILES_CLOUD_PROJECT_ID=

# Optional customer-owned S3. Prefer workload identity in production.
# FILES_STORAGE_DRIVER=s3
# FILES_S3_ENDPOINT=http://localhost:9000
# FILES_S3_REGION=us-east-1
# FILES_S3_BUCKET=uploads
# FILES_S3_ACCESS_KEY_ID=
# FILES_S3_SECRET_ACCESS_KEY=
# FILES_S3_FORCE_PATH_STYLE=true

# Optional customer-owned Postgres for more than one app/worker host.
# FILES_METADATA_DRIVER=postgres
# FILES_POSTGRES_URL=postgresql://USER:PASSWORD@HOST:5432/APP
# FILES_PROVIDER=distributed
# FILES_PROCESSING_MODE=distributed
# FILES_WORKER_AUTOSPAWN=false
# FILES_SINGLE_HOST_ACK=false

# Browser client. The host reads these and passes them to
# uploadClientOptionsFromEnv. The browser bundle does not read process.env.
# indexeddb (default) or memory.
# FILEVORA_RESUME_STRATEGY=indexeddb
# never, auto (default), or always. auto keeps the blob only under the byte cap.
# FILEVORA_RESUME_PERSIST_BLOB=auto
# Default 33554432.
# FILEVORA_RESUME_MAX_PERSISTED_BYTES=33554432
# sse (default) or poll.
# FILEVORA_PROGRESS_CHANNEL=sse
# Poll interval when the channel is poll, or after an SSE failure. Default 1000.
# FILEVORA_PROGRESS_POLL_MS=1000
