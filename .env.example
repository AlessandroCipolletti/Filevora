# Filevora reads process environment variables that you export.
# It does not load this file automatically. Copy values into the host app's env.
# Placeholders only. Do not put real credentials here.

FILES_ENV=development
FILES_PROVIDER=embedded
FILES_RUNTIME=long-running
FILES_STORAGE_DRIVER=filesystem
FILES_STORAGE_ROOT=./.files/objects
# No FILEVORA_DATABASE_URL means lite mode: object storage + Redis, no database.
# Set FILEVORA_DATABASE_URL to run stored mode. The scheme picks the driver:
#   postgres:// or postgresql://  PostgreSQL
#   mysql:// or mariadb://        MySQL or MariaDB
#   sqlite://path or a file path  SQLite
# FILEVORA_METADATA_MODE=stored is an optional override. Stored with no URL is an error.
# FILEVORA_DATABASE_URL=postgres://filevora:filevora@127.0.0.1:5432/filevora
# FILEVORA_DATABASE_URL=mysql://filevora:filevora@127.0.0.1:3306/filevora
# FILEVORA_DATABASE_URL=sqlite://./.files/host.sqlite
# FILEVORA_AUTO_MIGRATE=true
FILES_POSTGRES_SCHEMA=filevora
FILES_PROCESSING_MODE=worker
FILES_WORKER_AUTOSPAWN=true
# Processing queue only. Asset ids are not stored in Redis.
# REDIS_URL=redis://127.0.0.1:6379
FILES_KEEP_ORIGINAL=true
FILES_DEFAULT_VISIBILITY=private
FILES_DEFAULT_PRESET=web-optimized
# Image thumbnail and the legacy video poster. 320 or 480. Default 480.
FILES_THUMBNAIL_WIDTH=480
# Gemini descriptions need stored mode (FILEVORA_DATABASE_URL) and a key.
# Content is sent to Google only when a description runs. Default is off.
# FILEVORA_GEMINI_API_KEY=
# FILEVORA_DESCRIBE_ASSETS=false
# FILEVORA_GEMINI_MODEL=gemini-3.5-flash-lite
# FILEVORA_DESCRIBE_VIDEO_HEIGHT=720
# Semantic search (POST /files/search). Vectors are written when a description finishes.
# FILEVORA_EMBEDDING_MODEL=gemini-embedding-001
# FILEVORA_EMBEDDING_DIMENSIONS=768
# Uncalibrated placeholder. Tune it on your own assets. See docs/search.md.
# FILEVORA_SEARCH_MIN_SCORE=0.55
# FILEVORA_SEARCH_MAX_RESULTS=100
FILES_ALLOW_PUBLIC_FILES=false
FILES_RETENTION_ENABLED=false
# Lifetime from creation, and lifetime since the last delivery URL. At least one is required when retention is on.
# FILES_RETENTION_MAX_AGE_DAYS=30
# FILES_UNUSED_RETENTION_DAYS=14
# FILES_RETENTION_GRACE_DAYS=7
# Repeat interval for the cleanup job, and the minimum age of an orphan file.
# FILES_CLEANUP_INTERVAL_MINUTES=60

# Part size for filesystem and S3 uploads. Default 8388608. Minimum 65536.
# FILES_UPLOAD_CHUNK_BYTES=65536
# Upload session lifetime in seconds. Default 86400. Range 60 to 604800.
# FILES_UPLOAD_SESSION_TTL_SECONDS=86400

# Reserved for a future managed provider. Ignored unless provider=managed,
# which currently fails with FEATURE_NOT_AVAILABLE.
# FILES_CLOUD_API_KEY=
# FILES_CLOUD_ENDPOINT=
# FILES_CLOUD_PROJECT_ID=

# Optional customer-owned S3. Prefer workload identity in production.
# FILES_STORAGE_DRIVER=s3
# FILES_S3_ENDPOINT=http://localhost:9000
# FILES_S3_REGION=us-east-1
# FILES_S3_BUCKET=uploads
# FILES_S3_ACCESS_KEY_ID=
# FILES_S3_SECRET_ACCESS_KEY=
# FILES_S3_FORCE_PATH_STYLE=true

# Optional customer-owned Postgres for more than one app/worker host.
# FILES_METADATA_DRIVER=postgres
# FILES_POSTGRES_URL=postgresql://USER:PASSWORD@HOST:5432/APP
# FILES_PROVIDER=distributed
# FILES_PROCESSING_MODE=distributed
# FILES_WORKER_AUTOSPAWN=false
# FILES_SINGLE_HOST_ACK=false

# Browser client. The host reads these and passes them to
# uploadClientOptionsFromEnv. The browser bundle does not read process.env.
# indexeddb (default) or memory.
# FILEVORA_RESUME_STRATEGY=indexeddb
# never, auto (default), or always. auto keeps the blob only under the byte cap.
# FILEVORA_RESUME_PERSIST_BLOB=auto
# Default 33554432.
# FILEVORA_RESUME_MAX_PERSISTED_BYTES=33554432
# sse (default) or poll.
# Remote URL import. POST /assets/from-url downloads the URL in the SDK.
# Defaults: http/https only, ports 80 and 443, 100MB, 10s connect, 120s total, 3 redirects.
# Private, loopback, link-local, multicast, and cloud metadata addresses are blocked.
# FILEVORA_REMOTE_ALLOW_PRIVATE=true allows them on the URL you pass, not on a redirect.
# FILEVORA_REMOTE_MAX_BYTES=104857600
# FILEVORA_REMOTE_CONNECT_TIMEOUT_MS=10000
# FILEVORA_REMOTE_TIMEOUT_MS=120000
# FILEVORA_REMOTE_MAX_REDIRECTS=3
# FILEVORA_REMOTE_ALLOWED_PORTS=80,443
# FILEVORA_REMOTE_HOST_ALLOW=
# FILEVORA_REMOTE_HOST_DENY=
# Malware scan. Unset or off skips the scan. clamav uses INSTREAM on the host below.
# FILEVORA_MALWARE_SCAN=clamav
# FILEVORA_CLAMAV_HOST=127.0.0.1
# FILEVORA_CLAMAV_PORT=3310
# Image versions: gps (default, drop location), all (drop metadata), or none (keep it).
# FILEVORA_EXIF_STRIP=gps
# Per detected type, not extension. Exact types beat wildcards. Example: image/png=1048576,video/*=104857600
# FILEVORA_TYPE_MAX_BYTES=
# Test-only. sync runs processing in the caller and does not use Redis. Prefer filevora/testing.
# FILES_PROCESSING_MODE=sync
# Optional completion webhook. Per-request webhook.url overrides this URL.
# FILEVORA_WEBHOOK_URL=
# FILEVORA_WEBHOOK_SECRET=
# Localhost webhook targets are allowed outside production. Set false to reject them.
# FILES_WEBHOOKS_ALLOW_LOOPBACK=true
# FILEVORA_PROGRESS_CHANNEL=sse
# Poll interval when the channel is poll, or after an SSE failure. Default 1000.
# FILEVORA_PROGRESS_POLL_MS=1000
