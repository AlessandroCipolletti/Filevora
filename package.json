{
  "name": "filevora-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm --filter filevora build",
    "typecheck": "pnpm build && pnpm --filter filevora exec tsc -p tsconfig.test.json --noEmit && pnpm --filter fixture-app typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm build && pnpm --filter filevora test",
    "verify": "pnpm typecheck && pnpm lint && pnpm --filter filevora test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.7",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
