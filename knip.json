{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["ffmpeg", "pdftoppm"],
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.ts"],
      "project": ["scripts/**/*.ts"]
    },
    "packages/filevora": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.test.ts"]
    },
    "examples/fixture-app": {
      "entry": ["src/run.ts"]
    },
    "examples/node-minimal": {
      "entry": ["server.ts"]
    }
  }
}
