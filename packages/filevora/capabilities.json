{
  "schemaVersion": 1,
  "name": "filevora",
  "package": "filevora",
  "version": "0.1.0",
  "needsAccount": false,
  "managedProvider": "unsupported",
  "billing": "unsupported",
  "accounts": "unsupported",
  "hostedControlPlane": "unsupported",
  "imports": [
    "filevora/server",
    "filevora/client",
    "filevora/http",
    "filevora/worker",
    "filevora/types"
  ],
  "cli": ["capabilities --json", "config validate --json"],
  "runtimes": {
    "node": {
      "status": "tested",
      "engines": ">=22.13",
      "verifiedOn": ["darwin node v26.5.0"]
    },
    "browser": {
      "status": "tested",
      "notes": "The client entry bundles without Node built-ins. Upload methods are not implemented yet."
    }
  },
  "features": {
    "configValidation": "tested",
    "errorCatalog": "tested",
    "browserServerSplit": "tested",
    "managedProviderRejected": "tested",
    "filesystemStorage": "tested",
    "sqliteMetadata": "tested",
    "httpUpload": "tested",
    "resumableUpload": "not-implemented",
    "durableQueue": "not-implemented",
    "embeddedWorker": "not-implemented",
    "doctor": "not-implemented",
    "imageProcessing": "not-implemented",
    "videoProcessing": "not-implemented",
    "audioProcessing": "not-implemented",
    "s3Storage": "not-implemented",
    "postgresMetadata": "not-implemented",
    "pdfExtraction": "not-implemented",
    "tabularNormalization": "not-implemented",
    "retention": "not-implemented",
    "webhooks": "not-implemented",
    "aiDiagnostics": "reserved",
    "semanticSearch": "unsupported",
    "ocr": "unsupported"
  },
  "notes": [
    "A Filevora account is not required and this package cannot create one.",
    "Status tested is used only for behavior covered by an automated test in this repository.",
    "Local verification recorded in runtimes.node.verifiedOn. GitHub Actions is defined and has not been executed from this environment."
  ]
}
